# Copy to .env.local and fill in. Both values are safe in a browser bundle:
# the publishable key is low-privilege by design and access is decided by the
# RLS policies in supabase/migrations/001_shared_submission.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Same value on all five machines, or you will not see each other's rows.
VITE_SUBMISSION_ROOM=aic26-p1

# Name shown next to your submitted rows.
VITE_SUBMISSION_USER=
