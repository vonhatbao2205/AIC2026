# AIC26 retrieval backend configuration.
# Copy to .env (or export in your shell) and fill in real values.
# Secrets stay server-side and are NEVER returned to the frontend.

# --- Elastic Cloud ---
ELASTIC_ENDPOINT=
ELASTIC_API_KEY=

# --- Milvus / Zilliz ---
# BTC / legacy data: all retrieval channels
MILVUS_ENDPOINT_1=
MILVUS_TOKEN_1=
# InfoShot++ keyframes; PE and Qwen vectors live in separate collections here.
MILVUS_ENDPOINT_2=
MILVUS_TOKEN_2=

# --- PE-Core-G14 text encoder (Kaggle FastAPI server, cloudflared tunnel) ---
PE_ENCODER_URL=
# Optional; sent as "Authorization: Bearer <token>" when set.
PE_ENCODER_TOKEN=
# GLAP audio↔text encoder for audio VECTOR search (/encode-audio-text on the SAME
# Kaggle server). Leave blank to reuse PE_ENCODER_URL.
GLAP_ENCODER_URL=

# --- Qwen3-VL-Embedding-8B text encoder (Colab A100 + cloudflared tunnel) ---
# Independent 4096-d embedding space used only by the InfoShot++ profile.
QWEN3_VL_ENCODER_URL=
# Must equal the bearer token configured by the Qwen encoder notebook.
QWEN3_VL_ENCODER_TOKEN=
# Includes a cold first inference after the model worker starts.
QWEN3_VL_ENCODER_TIMEOUT_SECONDS=120

# --- Cloudflare R2 media (public base URL only, no write creds) ---
MEDIA_BASE_URL=
# InfoShot++ KEYFRAMES. Videos have their own origin below — the two are split
# because a thumbnail grid and a video stream do not want the same host.
KEYFRAME_MEDIA_BASE_URL_2=https://huggingface.co/buckets/Baonenha1/aic26-media/resolve
# Video origin per profile. Profile 1 (K01-K20) stays on R2; nothing else holds
# those videos yet.
VIDEO_MEDIA_BASE_URL_1=
# L21-L30 videos. The named Cloudflare tunnel measured ~63 ms to first byte
# against ~834 ms for the HF bucket, which 302-redirects every range request to
# its CDN and pays that round trip again on every seek.
VIDEO_MEDIA_BASE_URL_2=https://video.baoencoder.site
# Where the console retries a video the primary origin failed to serve. A tunnel
# terminates on a machine that can be switched off; the bucket is always-on
# hosting, so it stays configured here rather than being replaced. Leave empty to
# disable the retry — pointing both at one origin would dress a single point of
# failure up as redundancy.
VIDEO_MEDIA_FALLBACK_BASE_URL_1=
VIDEO_MEDIA_FALLBACK_BASE_URL_2=https://huggingface.co/buckets/Baonenha1/aic26-media/resolve

# --- NVIDIA NIM (Nemotron query parser). Optional; heuristics used if absent ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
# Routing parser model. qwen3-next ~28s (full JSON); nemotron-3-ultra-550b ~45s.
NVIDIA_MODEL=
# Fast NIM model for query expansion (~2s, multilingual, outputs English).
# The 550B model is ~45s/call (too slow); llama-3.1-8b echoes Vietnamese.
NVIDIA_FAST_MODEL=
# Slim-schema parse: ~2x faster routing but can misroute query_type on ambiguous
# queries (A/B verified). Leave false for accuracy; set true to trade for speed.
SLIM_PARSE=false

# --- NVILA-8B QA worker (optional; run aic26_nvila8b_qa_colab_server.ipynb) ---
# Cloudflare URL printed by the Colab notebook, for example:
# https://random-words.trycloudflare.com
NVILA_BASE_URL=
# Must equal the Colab secret AIC26_NVILA_TOKEN.
NVILA_TOKEN=
# A100 runs native BF16; allow room for both visual passes and tunnel latency.
# Twelve diverse frames is the quality/latency default even though A100 can fit more.
NVILA_TIMEOUT_SECONDS=240
NVILA_MAX_CANDIDATES=12

# --- Qwen3-VL visual reranker (optional; run aic26_qwen3vl_reranker8b_colab_server.ipynb) ---
# Rescores the PE candidate pool for one search when the operator ticks
# "Rerank" in the query panel. Off unless ticked; leaving these blank simply
# hides the tick box.
QWEN_RERANKER_URL=
# Must equal the Colab secret AIC26_QWEN_RERANKER_TOKEN.
QWEN_RERANKER_TOKEN=
# Set false to hide the tick box entirely even when a worker is configured.
QWEN_RERANKER_ENABLED=true
# Candidates retrieved from Milvus BEFORE reranking. Keep it above the console's
# retrieval depth: the reranker reorders what it is given and cannot recover a
# frame PE never returned.
QWEN_RERANKER_CANDIDATES=200
# Lần rerank đầu của mỗi phiên chậm nhất: worker phải tải toàn bộ keyframe ứng
# viên trước khi chấm được điểm nào. 30s là không đủ cho pool 200.
QWEN_RERANKER_TIMEOUT_SECONDS=120

# --- DeepSeek web search grounding for QA (optional, backend only) ---
# Create at platform.deepseek.com. Never put this key in the frontend or Colab.
# NOTE: the built-in web_search tool lives ONLY on the Responses API and only on
# deepseek-v4-flash; /chat/completions rejects every non-`function` tool.
DEEPSEEK_API_KEY=
DEEPSEEK_GROUNDING_MODEL=deepseek-v4-flash
DEEPSEEK_GROUNDING_BASE_URL=https://api.deepseek.com
DEEPSEEK_GROUNDING_ENABLED=true
DEEPSEEK_GROUNDING_TIMEOUT_SECONDS=90
# Thinking is on by default and shares this budget with the answer; too low a
# value returns reasoning only and an empty message.
DEEPSEEK_GROUNDING_MAX_OUTPUT_TOKENS=8000
# low | high | max
DEEPSEEK_GROUNDING_REASONING_EFFORT=high
# Auto-search when visual answer confidence is below this, or the question asks
# to resolve a named real-world entity (name/person/brand/place/company).
DEEPSEEK_GROUNDING_AUTO_THRESHOLD=0.55

# --- DRES (official BTC evaluation server, Client API v2) -------------------
# Public host; inside SELab (I87) use http://10.0.1.21:20740 instead.
DRES_BASE_URL=http://if-wan4.selab.edu.vn:20740
# Participant account from the organisers. Stays backend-side (never in the UI).
DRES_USERNAME=
DRES_PASSWORD=
# Optional: reuse an existing sessionId instead of logging in (cannot renew).
DRES_SESSION=
# Optional: pin one evaluation run id; empty = auto-pick from the query type.
DRES_EVALUATION_ID=
# KIS/TRAKE answers are temporal ranges in ms; the picked instant is padded by
# this on both sides (0 would submit a zero-length range).
DRES_SEGMENT_PAD_MS=500
DRES_TIMEOUT_SECONDS=20

# --- Index / collection overrides (only if you re-uploaded with a new prefix) ---
# Profile 1 = BTC keyframes (v1 indices); profile 2 = InfoShot++ keyframes (v2).
IDX_KEYFRAME_MAP_1=aic26_keyframe_map_v1
IDX_KEYFRAME_MAP_2=aic26_keyframe_map_infoshotpp_v1
IDX_OCR=aic26_ocr_keyframes_v1
IDX_SPEECH=aic26_speech_segments_v1
IDX_AUDIO=aic26_audio_windows_v1
IDX_OCR_2=aic26_ocr_keyframes_v2
IDX_SPEECH_2=aic26_speech_segments_v2
IDX_AUDIO_2=aic26_audio_windows_v2
# Categories the InfoShot++ OCR artifact does not cover yet (comma separated).
OCR_MISSING_CATEGORIES_2=L26
MILVUS_IMAGE_COLLECTION_1=aic26_image_peg14_v1
MILVUS_IMAGE_COLLECTION_2=aic26_image_peg14_infoshotpp_v1
# Native 4096-d FP32 Qwen3-VL vectors. Never point this at the PE collection.
MILVUS_QWEN3_VL_IMAGE_COLLECTION_2=aic26_image_qwen3vl8b_infoshotpp_v3
MILVUS_AUDIO_COLLECTION=aic26_audio_glap_v1

# --- Dev ---
# Mock mode returns deterministic fixtures so the UI/tests run without services.
AIC26_MOCK_MODE=false
# VI→EN translation of the visual query when the LLM parser is off (fallback).
TRANSLATE_TO_EN=true
# Whisper STT model for /api/transcribe voice input (tiny|base|small|medium).
# base is a good CPU default; small is more accurate for Vietnamese but slower.
WHISPER_MODEL=base
CORS_ORIGINS=http://localhost:5173
