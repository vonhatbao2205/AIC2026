# =============================================================================
# AIC26 Retrieval — root .gitignore
# Keep code, scripts, notebooks and docs. Exclude secrets, large data and caches.
# =============================================================================

# ---- Secrets — NEVER commit (loose key files + env) -------------------------
.env
*.env
!*.env.example
backend/.env
.env.local
frontend/.env.local
api-key.txt
elastic_apikey.txt
elastic_endpoint.txt
milvus_token.txt
milvus_endpoint.txt
cloudflareR2_api.txt
nvidia_api_key.txt
# Defensive patterns for any other loose credential files
*api*key*.txt
*_token.txt
HF_BUCKET/HF_TOKEN.txt
*_endpoint.txt
*secret*.txt
*credentials*.json
/VBS_Account.txt

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
.uv-cache/
# Candidate pools captured from the live services by benchmarks/cache_pools.py.
# Derived data: regenerate it rather than committing a snapshot of the indices.
benchmarks/cache/

# Submission packs written by the console's export button. They are contest
# output, not source, and a new one lands next to the last on every attempt.
/submission.zip
/submission (*).zip

# ---- Node / frontend --------------------------------------------------------
node_modules/
frontend/dist/
frontend/*.tsbuildinfo
*.local
*.log
npm-debug.log*
yarn-error.log*

# ---- Large data & generated artifacts (regenerated by the pipelines) --------
# Model / embedding dumps
VideoRetrieval/tara_embeddings/
VideoRetrieval/tara-tarsier2-7b-3584-batch2-clip-v1/
VideoRetrieval/tara-tarsier2-7b-3584-batch2-s01-clip-v1/
*.pkl
*.pt
*.npy
*.faiss
# Bulk index/staging records and transcripts
*.jsonl
# Reviewed annotation source records belong in Git; retrieval dumps do not.
!/benchmarks/progressive/annotations/ground_truth.jsonl
!/benchmarks/progressive/annotations/source_inventory.jsonl
!/benchmarks/progressive/annotations/source_frames.jsonl
!/benchmarks/progressive/annotations/annotation_decisions.jsonl
# Local video/frame evidence is retained separately with a SHA-256 manifest.
/benchmarks/progressive/annotations/evidence/
elastic_staging/
elastic_staging_v2/
elastic_staging_batch2/
# Batch-2 content index (contact sheets, OCR, camera metadata; ~370 MB).
/Batch2/batch2_content/
speech_out/
results_audio_event/
map-keyframes-s1-s2/
backend/data/
# Media
*.wav
*.mp3
*.mp4
*.mkv
# Pipeline checkpoints / runtime state
*_checkpoint.json
milvus_upload_checkpoint.json
.milvus_upload_state_*.json
milvus_upload_pe_core_verification.json
milvus_upload_qwen3_vl_embedding_8b_verification.json
milvus_upload_pe_core_batch2_verification.json
.elastic_upload_batch2_keyframe_map_state.json
elastic_upload_batch2_keyframe_map_verification.json
.elastic_upload_batch2_ocr_speech_state.json
elastic_upload_batch2_ocr_speech_verification.json
r2_publish_n_web_videos_report.json
r2_reencode_n_damaged_videos_report.json

# ---- Paper (kept out of git) -----------------------------------------------
Paper/
# MMM 2026 proceedings (Springer LNCS), reference reading for the paper
Part4.pdf
.hf_media_local_upload_state*.json

# ---- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.~*.xlsx

# ---- Packaged app (docker compose) ------------------------------------------
# The imported .env and the submit history of a local container run.
/config/
/data/
# Distributable bundle produced by scripts/package.sh
/dist-app/
/dist-app.zip
/dist-app.tar.gz

# ---- Paper working files ----------------------------------------------------
# Keep the canonical Paper sources already tracked at Paper/, but ignore local
# source archives and the generated/expanded technical-report workspace.
/Paper/*.zip
/Paper/technical-report/
/baocaokythuat.md

# ---- Packaged bundles ------------------------------------------------------
# docker/build-bundle.sh embeds the team's real .env inside the zip, so the
# archive is as sensitive as the credentials it carries. The `*.env` rule above
# does not reach inside an archive.
docker/dist/
dist-app/
dist-app.zip
Supabase/project_url.txt
Supabase/publishable_key.txt
HF_BUCKET/build_aic26_hf_media_colab.py
HF_BUCKET/AIC2026_HF_Media_Migration_Colab.ipynb
dontsharethisfuckingshit.json
Vấn-đề-ranking-OCR.md
reranker.md
vlm_query_pipeline/
HF_BUCKET/HF_S3_CREDENTIALS.txt
TKIS_72_queries_PHM_3_hints.xlsx
cloudflare run.txt

# Local progressive retrieval traces and frozen parser plans
/benchmarks/progressive/runs/
/benchmarks/progressive/locks/


# Local model credentials and agent benchmark traces
/API_KEY/
/benchmarks/agent/runs/
