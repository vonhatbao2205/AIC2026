# =============================================================================
# AIC26 Retrieval — root .gitignore
# Keep code, scripts, notebooks and docs. Exclude secrets, large data and caches.
# =============================================================================

# ---- Secrets — NEVER commit (loose key files + env) -------------------------
.env
*.env
!*.env.example
backend/.env
.env.local
frontend/.env.local
api-key.txt
elastic_apikey.txt
elastic_endpoint.txt
milvus_token.txt
milvus_endpoint.txt
cloudflareR2_api.txt
nvidia_api_key.txt
# Defensive patterns for any other loose credential files
*api*key*.txt
*_token.txt
HF_BUCKET/HF_TOKEN.txt
*_endpoint.txt
*secret*.txt
*credentials*.json

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.venv/
venv/
env/
.uv-cache/

# ---- Node / frontend --------------------------------------------------------
node_modules/
frontend/dist/
frontend/*.tsbuildinfo
*.local
*.log
npm-debug.log*
yarn-error.log*

# ---- Large data & generated artifacts (regenerated by the pipelines) --------
# Model / embedding dumps
*.pkl
*.pt
*.npy
*.faiss
# Bulk index/staging records and transcripts
*.jsonl
elastic_staging/
elastic_staging_v2/
speech_out/
results_audio_event/
map-keyframes-s1-s2/
backend/data/
# Media
*.wav
*.mp3
*.mp4
*.mkv
# Pipeline checkpoints / runtime state
*_checkpoint.json
milvus_upload_checkpoint.json
.milvus_upload_state_*.json
milvus_upload_pe_core_verification.json
.hf_media_local_upload_state*.json

# ---- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- Packaged app (docker compose) ------------------------------------------
# The imported .env and the submit history of a local container run.
/config/
/data/
# Distributable bundle produced by scripts/package.sh
/dist-app/
/dist-app.zip
/dist-app.tar.gz
